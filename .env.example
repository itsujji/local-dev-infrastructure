# Copy to .env and adjust values for local development:
#   cp .env.example .env
#
# Docker Compose loads .env from this directory automatically.
# Defaults below match docker-compose.yml when a variable is omitted.

# MongoDB (core)
MONGO_USERNAME=admin
MONGO_PASSWORD=password

# DocumentDB (core)
DOCDB_USERNAME=admin
DOCDB_PASSWORD=password

# PostgreSQL (--profile database)
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_DB=senserank

# Grafana (--profile monitoring)
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
